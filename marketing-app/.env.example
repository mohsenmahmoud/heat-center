# ─────────────────────────────────────────────────────────────
#  Qudra Marketing Studio: copy this file to ".env" and fill in.
#  .env stays on your computer (it is git-ignored). Never share it.
# ─────────────────────────────────────────────────────────────

# ── Required: Claude writes every script and post ────────────
# Get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Default is Claude Opus 5.5. For lower cost use claude-sonnet-5-5.
CLAUDE_MODEL=claude-opus-5-5
# If Claude declines a request, retry on Anthropic's recommended fallback model (default | off)
CLAUDE_FALLBACKS=default

# Try the whole app without any key (fixed sample content, no AI calls)
MOCK_AI=false

# ── App access ───────────────────────────────────────────────
# Leave empty for no login, or set a password your team shares
APP_PASSWORD=
PORT=5174
# The app only ever listens on this machine. Keep 127.0.0.1.
HOST=127.0.0.1

# ── Brand defaults for the video CTA ─────────────────────────
BRAND_WEBSITE=qudratms.com
BRAND_WHATSAPP=

# ── Optional: free stock footage & photos ────────────────────
# https://www.pexels.com/api/  (free)
PEXELS_API_KEY=
# https://pixabay.com/api/docs/  (free)
PIXABAY_API_KEY=

# ── Optional: AI images (none | openai | replicate) ──────────
IMAGE_PROVIDER=none
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# ── Optional: AI voiceover (none | elevenlabs | openai) ──────
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS uses OPENAI_API_KEY above
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── Advanced ─────────────────────────────────────────────────
# Where history, uploads and videos are stored (default: ./data)
DATA_DIR=
# Use your own Chrome Headless Shell instead of the one Remotion downloads
BROWSER_EXECUTABLE=
# Parallel render threads (empty = automatic)
RENDER_CONCURRENCY=
