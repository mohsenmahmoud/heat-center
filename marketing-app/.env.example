# ─────────────────────────────────────────────────────────────
#  Qudra Marketing Studio: copy this file to ".env" and fill in.
#  .env stays on your computer (it is git-ignored). Never share it.
# ─────────────────────────────────────────────────────────────

# ── Required: ONE AI writer (Claude or Gemini) ───────────────
# Which AI writes scripts and plans: claude | gemini
# Leave empty to use whichever key is filled in (Claude first).
AI_PROVIDER=

# Claude: get a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Default is Claude Opus 5.5. For lower cost use claude-sonnet-5-5.
CLAUDE_MODEL=claude-opus-5-5
# If Claude declines a request, retry on Anthropic's recommended fallback model (default | off)
CLAUDE_FALLBACKS=default

# Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest follows Google's newest Flash model. Use a Pro model for higher quality.
GEMINI_MODEL=gemini-flash-latest

# Try the whole app without any key (fixed sample content, no AI calls)
MOCK_AI=false

# ── App access ───────────────────────────────────────────────
# Leave empty for no login, or set a password your team shares
APP_PASSWORD=
PORT=5174
# The app only ever listens on this machine. Keep 127.0.0.1.
HOST=127.0.0.1

# ── Qudra contact, used only when the app first creates the Qudra brand ──
# (after that, edit every brand, including Qudra, in the Brands tab)
BRAND_WEBSITE=qudratms.com
BRAND_WHATSAPP=

# ── Optional: free stock footage & photos ────────────────────
# https://www.pexels.com/api/  (free)
PEXELS_API_KEY=
# https://pixabay.com/api/docs/  (free)
PIXABAY_API_KEY=

# ── AI scene images ──────────────────────────────────────────
# Empty = automatic: Gemini makes the scene images (uses GEMINI_API_KEY, no extra key).
# Or: gemini | openai | replicate | off
IMAGE_PROVIDER=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# ── AI voiceover ─────────────────────────────────────────────
# Empty = automatic: ElevenLabs if configured, otherwise Gemini (uses GEMINI_API_KEY, no extra key).
# Or force one: gemini | elevenlabs | openai
TTS_PROVIDER=
# Gemini voice model and default voice (Charon, Orus, Puck, Kore, Aoede, Zephyr)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon
# Playback speed of AI voices in the video (1.0–1.5). Pitch is preserved.
VOICE_RATE=1.1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI TTS uses OPENAI_API_KEY above
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── Advanced ─────────────────────────────────────────────────
# Where history, uploads and videos are stored (default: ./data)
DATA_DIR=
# Use your own Chrome Headless Shell instead of the one Remotion downloads
BROWSER_EXECUTABLE=
# Parallel render threads (empty = automatic)
RENDER_CONCURRENCY=
